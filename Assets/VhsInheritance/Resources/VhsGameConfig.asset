  loreFragments:
  - "1994. \u041D\u0430 \u0437\u0430\u043F\u0438\u0441\u0438 \u043F\u0443\u0441\u0442\u043E\u0439 \u0437\u0430\u043B. \u041A\u0430\u043C\u0435\u0440\u0430 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043A \u0434\u0432\u0435\u0440\u0438 \u043F\u043E\u0434\u0441\u043E\u0431\u043A\u0438, \u0445\u043E\u0442\u044F \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0435\u0451 \u043D\u0435\u043A\u043E\u043C\u0443."
  - "1996. \u0412 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0438 \u044D\u043A\u0440\u0430\u043D\u0430 \u0434\u0435\u0434 \u0441\u043F\u043E\u0440\u0438\u0442 \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0431\u0435\u0437 \u043B\u0438\u0446\u0430: \xAB\u0421\u0430\u043B\u043E\u043D \u0441\u0430\u043C \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442, \u0447\u0442\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C\xBB."
  - "1998. \u0410\u043F\u043F\u0430\u0440\u0430\u0442 \u043F\u0435\u0447\u0430\u0442\u0430\u0435\u0442 \u043D\u0430\u043A\u043B\u0435\u0439\u043A\u0443 \u0441 \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u0439 \u0434\u0430\u0442\u043E\u0439. \u041F\u043E\u0434 \u043D\u0435\u0439 \u2014 \u0432\u0430\u0448\u0435 \u0438\u043C\u044F, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C."
  - "2001. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0437\u0430\u043F\u0438\u0441\u044C. \u0414\u0435\u0434 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0441\u0432\u0435\u0442 \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043A\u043B\u044E\u0447 \u043F\u043E\u0434 \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440\u043E\u043C: \xAB\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u0430\xBB."
