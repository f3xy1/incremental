# Test and coverage output
/[Tt]est[Rr]esults/
/[Cc]ode[Cc]overage/
/TestResult.xml
/nunit-*.xml

# Python caches used by the art generation tools
__pycache__/
*.py[cod]
.venv/
venv/

# Operating system files
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini

